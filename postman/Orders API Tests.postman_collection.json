  "item": [
    {
      "name": "Create Order",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.environment.set(\"orderId\", \"ORD-\" + Date.now());\r",
              "pm.environment.set(\"pollCount\", 0);\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status deve ser 201\", () => {\r",
              "  pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "pm.test(\"Resposta deve conter status PENDING\", () => {\r",
              "  const json = pm.response.json();\r",
              "  pm.expect(json.status).to.eql(\"PENDING\");\r",
              "  pm.expect(json).to.have.property(\"orderId\");\r",
              "});\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"orderId\": \"{{orderId}}\",\r\n  \"customer\": \"Larissa\",\r\n  \"total\": 100\r\n}\r\n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Order Status",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status deve ser 200\", () => {\r",
              "  pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Campo status deve ser PENDING/PROCESSED/FAILED\", () => {\r",
              "  const json = pm.response.json();\r",
              "  pm.expect([\"PENDING\",\"PROCESSED\",\"FAILED\"]).to.include(json.status);\r",
              "});\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/orders/{{orderId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders",
            "{{orderId}}"
          ]
        }
      },
      "response": []
