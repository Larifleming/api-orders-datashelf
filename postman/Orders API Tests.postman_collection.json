    {
      "name": "Poll Until PROCESSED",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();\r",
              "const status = json.status;\r",
              "\r",
              "let pollCount = parseInt(pm.environment.get(\"pollCount\") || \"0\", 10);\r",
              "const max = parseInt(pm.environment.get(\"maxPollAttempts\") || \"30\", 10);\r",
              "\r",
              "pm.test(\"Status deve existir\", () => {\r",
              "  pm.expect(status).to.be.a(\"string\");\r",
              "});\r",
              "\r",
              "if (status === \"PENDING\") {\r",
              "  pollCount += 1;\r",
              "  pm.environment.set(\"pollCount\", pollCount);\r",
              "\r",
              "  if (pollCount >= max) {\r",
              "    throw new Error(`Falhou: não processou a tempo (PENDING após ${pollCount} tentativas)`);\r",
              "  }\r",
              "  setTimeout(() => {\r",
              "    pm.execution.setNextRequest(\"Poll Until PROCESSED\");\r",
              "  }, 1000);\r",
              "} else if (status === \"PROCESSED\") {\r",
              "  pm.test(\"Pedido deve estar PROCESSED\", () => {\r",
              "    pm.expect(status).to.eql(\"PROCESSED\");\r",
              "  });\r",
              "  pm.execution.setNextRequest(null);\r",
              "} else if (status === \"FAILED\") {\r",
              "  throw new Error(\"Pedido retornou FAILED\");\r",
              "}\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/orders/{{orderId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders",
            "{{orderId}}"
          ]
        }
